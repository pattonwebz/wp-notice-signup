# Copy to .env and edit. .env is gitignored; this file is committed.
#
# The same variables drive every environment. Locally they come from .env; in CI
# they are injected from repository secrets. Real environment variables always
# beat the file, so CI can never be redirected by a stray .env.

# The site to scan. No trailing slash. There is no default: if this is unset the
# run fails rather than quietly scanning localhost and reporting a pass that
# proves nothing.
WORDPRESS_BASE_URL=http://127.0.0.1:8080

# Needed for targets marked `auth: true` — the wp-admin screens. Without these,
# admin screens cannot be scanned at all, which is how half a plugin ends up
# untested.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=password

# Pages belonging to the HOST SITE, comma separated.
#
# This plugin does not own the site it runs on and cannot know what pages exist
# there. Locally that may be a bare WordPress with only a home page; on staging
# it is a real site. List whatever is actually there — a target that 404s is a
# broken test, not a finding.
#
# These matter because the interesting failures are the ones a plugin causes on
# pages it did not write: anything hooked to wp_footer renders on all of them.
# SITE_PAGES=/features/,/pricing/,/status/,/about/,/contact/

# Include this plugin's own surfaces: its front-end states and its settings
# screen. Off by default so a scan of the host site alone does not fail merely
# because the plugin is deactivated.
# SCAN_PLUGIN=1

# Override the ruleset. Default wcag2a,wcag2aa.
# AXE_TAGS=wcag2a,wcag2aa,best-practice
